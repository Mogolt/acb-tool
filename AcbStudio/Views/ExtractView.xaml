<UserControl x:Class="AcbStudio.Views.ExtractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AcbStudio">

    <Grid Margin="24,8,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource SectionTitle}" FontSize="16" Text="Quick Extract"/>
            <TextBlock Style="{StaticResource HintText}" Margin="12,5,0,0"
                       Text="(AWB → numbered WAVs — for named output, use the Browse tab)"/>
        </StackPanel>

        <!-- Pickers -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="AWB file (input):"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,3"
                     Text="{Binding AwbPath, UpdateSourceTrigger=PropertyChanged}"
                     Tag="drop an .awb here or click Browse — PS4 and Switch RE4 both work"/>
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,3,0,3"
                    Content="Browse" Command="{Binding BrowseAwbCommand}"/>

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Output folder:"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,3"
                     Text="{Binding OutDir, UpdateSourceTrigger=PropertyChanged}"
                     Tag="where extracted WAV files will be saved"/>
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,3,0,3"
                    Content="Browse" Command="{Binding BrowseOutCommand}"/>
        </Grid>

        <!-- List header -->
        <Grid Grid.Row="2" Margin="14,10,14,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource HintText}" Text="Index"/>
            <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Text="Ch"/>
            <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="Rate (Hz)"/>
            <TextBlock Grid.Column="3" Style="{StaticResource HintText}" Text="Duration"/>
            <TextBlock Grid.Column="4" Style="{StaticResource HintText}" Text="Samples"/>
            <TextBlock Grid.Column="5" Style="{StaticResource HintText}" Text="Loop"/>
        </Grid>

        <!-- Waveform list -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="6"
                AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
            <ListBox Style="{StaticResource DarkListBox}" SelectionMode="Single"
                     ItemsSource="{Binding Waveforms}"
                     ItemContainerStyle="{StaticResource TrackListItem}"
                     MouseDoubleClick="WaveformDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding AwbIdText}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ChannelsText}" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding RateText}" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Column="4" Text="{Binding SamplesText}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="5" Text="{Binding LoopText}" Foreground="{StaticResource WarningBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Progress -->
        <Grid Grid.Row="4" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Style="{StaticResource SlimProgress}" VerticalAlignment="Center"
                         Maximum="{Binding ProgressMax}" local:Smooth.Target="{Binding Progress}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Margin="10,0,0,0"
                       VerticalAlignment="Center" Text="{Binding ProgressText}"/>
        </Grid>

        <!-- Log -->
        <Border Grid.Row="5" Background="{StaticResource PanelBrush}" CornerRadius="6" Height="96">
            <ScrollViewer x:Name="LogScroll" Margin="10,6" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource LogLine}"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource AccentButton}" Content="▶  Extract All"
                    Command="{Binding ExtractAllCommand}" IsEnabled="{Binding CanExtract}"/>
            <Button Style="{StaticResource FlatButton}" Content="■  Stop" Margin="8,0,0,0"
                    Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
            <Button Margin="20,0,0,0" Command="{Binding PreviewCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                        <Setter Property="Content" Value="♪  Preview"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewPlaying}" Value="True">
                                <Setter Property="Content" Value="♪  Playing…"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Style="{StaticResource FlatButton}" Content="■  Stop preview" Margin="8,0,0,0"
                    Command="{Binding StopPreviewCommand}" IsEnabled="{Binding IsPreviewPlaying}"/>
        </StackPanel>
    </Grid>
</UserControl>
