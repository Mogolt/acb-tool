<UserControl x:Class="AcbStudio.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,26,36,24" MaxWidth="900">

            <TextBlock Text="What do you want to do?" FontFamily="Segoe UI" FontSize="24"
                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Style="{StaticResource HintText}" FontSize="13" Margin="1,4,0,22"
                       Text="Mod the audio of Resident Evil 4 on PS4 &amp; Switch — no command line, no game files included."/>

            <!-- Task cards -->
            <UniformGrid Columns="3">
                <Button Style="{StaticResource TaskCard}" Margin="0,0,14,0" Command="{Binding GoBrowseCommand}">
                    <StackPanel>
                        <TextBlock Text="🎧" FontSize="28" Margin="0,0,0,10"/>
                        <TextBlock Text="Listen &amp; extract" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Style="{StaticResource HintText}" FontSize="12" Margin="0,6,0,0"
                                   Text="Open a sound bank, hear every cue by name, and save them all as WAV files."/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TaskCard}" Margin="7,0" Command="{Binding GoInjectCommand}">
                    <StackPanel>
                        <TextBlock Text="🔁" FontSize="28" Margin="0,0,0,10"/>
                        <TextBlock Text="Replace sounds" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Style="{StaticResource HintText}" FontSize="12" Margin="0,6,0,0"
                                   Text="Swap any sound for your own WAV. Sample rate and loops are handled for you."/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TaskCard}" Margin="14,0,0,0" Command="{Binding GoConvertCommand}">
                    <StackPanel>
                        <TextBlock Text="🔄" FontSize="28" Margin="0,0,0,10"/>
                        <TextBlock Text="Convert files" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Style="{StaticResource HintText}" FontSize="12" Margin="0,6,0,0"
                                   Text="Turn WAV files into the game's HCA format and back, one or a hundred at a time."/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Recent banks -->
            <TextBlock Text="Recent banks" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="2,28,0,8"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,8">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Options.RecentBanks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Stretch"
                                        Click="RecentClick">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                    <Button.Content>
                                        <Binding/>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource HintText}" Margin="8,4,0,4"
                               Text="Nothing yet — banks you open will show up here."
                               Visibility="{Binding Options.RecentBanks.Count, Converter={StaticResource ZeroToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Drop hint -->
            <Border Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                    CornerRadius="10" Margin="0,18,0,0" Padding="16,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0.8"/>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource MutedBrush}" Margin="0,1,10,0"/>
                    <TextBlock Style="{StaticResource HintText}" FontSize="12.5"
                               Text="Tip: drop an .acb, .awb, .wav or .hca anywhere in this window and it goes to the right place."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
