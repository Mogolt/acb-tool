<UserControl x:Class="AcbStudio.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AcbStudio">

    <Grid Margin="24,8,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource SectionTitle}" FontSize="16" Text="Browse &amp; Extract"/>
            <TextBlock Style="{StaticResource HintText}" Margin="12,5,0,0"
                       Text="open a bank, hear every cue, save them all as named WAVs"/>
        </StackPanel>

        <!-- Pickers -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="ACB file (input):"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,3"
                     Text="{Binding AcbPath, UpdateSourceTrigger=PropertyChanged}"
                     Tag="open an .acb — its companion .awb must sit in the same folder"/>
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,3,0,3"
                    Content="Browse" Command="{Binding BrowseAcbCommand}"/>

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Output folder:"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,3"
                     Text="{Binding OutDir, UpdateSourceTrigger=PropertyChanged}"
                     Tag="files are named after cues, e.g. LEON_GRUNT_HIT_01.wav"/>
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,3,0,3"
                    Content="Browse" Command="{Binding BrowseOutCommand}"/>
        </Grid>

        <!-- Cue tree + (advanced) waveform list -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">

            <!-- Waveform internals: advanced mode only -->
            <Grid DockPanel.Dock="Right" Width="470" Margin="14,0,0,0"
                  Visibility="{Binding DataContext.Options.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource HintText}" Text="Waveforms — double-click to preview" Margin="2,0,0,3"/>
                <Grid Grid.Row="1" Margin="14,0,14,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource HintText}" Text="AWB"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Text="Codec"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="Ch"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource HintText}" Text="Rate"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource HintText}" Text="Dur"/>
                    <TextBlock Grid.Column="5" Style="{StaticResource HintText}" Text="Samples"/>
                    <TextBlock Grid.Column="6" Style="{StaticResource HintText}" Text="Loop"/>
                </Grid>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8">
                    <ListBox x:Name="WaveformList" Style="{StaticResource DarkListBox}" SelectionMode="Extended"
                             ItemsSource="{Binding Waveforms}"
                             ItemContainerStyle="{StaticResource TrackListItem}"
                             MouseDoubleClick="WaveformDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AwbIdText}" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Codec}" Foreground="{StaticResource SuccessBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ChannelsText}" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RateText}" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding SamplesText}" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding LoopText}" Foreground="{StaticResource WarningBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource HintText}" Text="Cues" Margin="2,0,0,3"/>
                <Grid Grid.Row="1" Margin="14,0,14,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource HintText}" Text="Name"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Text="Cue ID"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="Length"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource HintText}" Text="Waves"/>
                </Grid>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8">
                    <Grid>
                    <TextBlock Style="{StaticResource HintText}" FontSize="12.5" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360"
                               Text="No bank open yet.&#10;&#10;Click Browse above and pick an .acb file — or just drop one anywhere in this window."
                               Visibility="{Binding Cues.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ListBox Style="{StaticResource DarkListBox}" SelectionMode="Single"
                             ItemsSource="{Binding Cues}"
                             SelectedItem="{Binding SelectedCue}"
                             ItemContainerStyle="{StaticResource TrackListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CueIdText}" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LengthText}" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding WaveCountText}" Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </Border>
            </Grid>

        </DockPanel>

        <!-- Progress -->
        <Grid Grid.Row="3" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Style="{StaticResource SlimProgress}" VerticalAlignment="Center"
                         Maximum="{Binding ProgressMax}" local:Smooth.Target="{Binding Progress}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Margin="10,0,0,0"
                       VerticalAlignment="Center" Text="{Binding ProgressText}"/>
        </Grid>

        <!-- Log -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="6" Height="96">
            <ScrollViewer x:Name="LogScroll" Margin="10,6" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource LogLine}"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource AccentButton}" Content="▶  Extract All (named)"
                    Command="{Binding ExtractAllCommand}" IsEnabled="{Binding CanExtract}"/>
            <Button Style="{StaticResource FlatButton}" Content="■  Stop" Margin="8,0,0,0"
                    Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
            <Button Margin="20,0,0,0" Command="{Binding PreviewCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                        <Setter Property="Content" Value="♪  Preview"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewPlaying}" Value="True">
                                <Setter Property="Content" Value="♪  Playing…"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Style="{StaticResource FlatButton}" Content="■  Stop preview" Margin="8,0,0,0"
                    Command="{Binding StopPreviewCommand}" IsEnabled="{Binding IsPreviewPlaying}"/>
        </StackPanel>
    </Grid>
</UserControl>
