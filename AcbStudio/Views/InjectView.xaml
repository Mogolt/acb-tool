<UserControl x:Class="AcbStudio.Views.InjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,8,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource SectionTitle}" FontSize="16" Text="Inject"/>
            <TextBlock Style="{StaticResource HintText}" Margin="12,5,0,0"
                       Text="(replace waveforms → rebuild AWB → patch ACB → save)"/>
        </StackPanel>

        <!-- Pickers -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="ACB file (input):"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,3"
                     Text="{Binding AcbPath, UpdateSourceTrigger=PropertyChanged}"
                     Tag="companion .awb must sit beside it"/>
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,3,0,3"
                    Content="Browse" Command="{Binding BrowseAcbCommand}"/>

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Output folder:"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,3"
                     Text="{Binding OutDir, UpdateSourceTrigger=PropertyChanged}"
                     Tag="modified .acb + .awb (same filenames) land here"/>
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,3,0,3"
                    Content="Browse" Command="{Binding BrowseOutCommand}"/>
        </Grid>

        <!-- Waveform list header -->
        <Grid Grid.Row="2" Margin="14,10,14,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="66"/>
                <ColumnDefinition Width="84"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource HintText}" Text="Wf#"/>
            <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Text="Cue name(s) — double-click to preview"/>
            <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="AWB"/>
            <TextBlock Grid.Column="3" Style="{StaticResource HintText}" Text="Ch"/>
            <TextBlock Grid.Column="4" Style="{StaticResource HintText}" Text="Rate"/>
            <TextBlock Grid.Column="5" Style="{StaticResource HintText}" Text="Dur"/>
            <TextBlock Grid.Column="6" Style="{StaticResource HintText}" Text="Pending"/>
        </Grid>

        <!-- Waveform list -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="6" MinHeight="150">
            <ListBox Style="{StaticResource DarkListBox}" SelectionMode="Single"
                     ItemsSource="{Binding Waveforms}"
                     SelectedItem="{Binding SelectedWaveform}"
                     ItemContainerStyle="{StaticResource TrackListItem}"
                     MouseDoubleClick="WaveformDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TableIndexText}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CueNames}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding AwbIdText}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding ChannelsText}" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Column="4" Text="{Binding RateText}" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Column="5" Text="{Binding DurationText}" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Column="6" Text="{Binding PendingText}" Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource FlatButton}" Foreground="{StaticResource TextBrush}"
                    Content="↻  Replace with WAV…" Command="{Binding ReplaceCommand}"
                    IsEnabled="{Binding CanReplace}"/>
            <Button Style="{StaticResource FlatButton}" Content="–  Remove from pending" Margin="6,0,0,0"
                    Command="{Binding RemovePendingCommand}" IsEnabled="{Binding CanRemovePending}"/>
            <Button Style="{StaticResource FlatButton}" Foreground="{StaticResource TextBrush}"
                    Content="♪  Preview source" Margin="18,0,0,0"
                    Command="{Binding PreviewSourceCommand}"/>
            <Button Style="{StaticResource FlatButton}" Foreground="{StaticResource TextBrush}"
                    Content="♪  Preview replacement" Margin="6,0,0,0"
                    Command="{Binding PreviewReplacementCommand}"/>
            <Button Style="{StaticResource FlatButton}" Content="■  Stop preview" Margin="6,0,0,0"
                    Command="{Binding StopPreviewCommand}" IsEnabled="{Binding IsPreviewPlaying}"/>
        </StackPanel>

        <!-- Pending replacements -->
        <Grid Grid.Row="5" Margin="14,12,14,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource HintText}" Text="Wf#"/>
            <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Text="Pending replacements"/>
            <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="Replacement"/>
            <TextBlock Grid.Column="3" Style="{StaticResource HintText}" Text="New format"/>
        </Grid>
        <Border Grid.Row="6" Background="{StaticResource DeepBrush}" CornerRadius="6" Height="86">
            <ListBox Style="{StaticResource DarkListBox}" SelectionMode="Single"
                     ItemsSource="{Binding Pending}"
                     SelectedItem="{Binding SelectedPending}"
                     ItemContainerStyle="{StaticResource TrackListItem}"
                     MouseDoubleClick="PendingDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TableIndexText}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CueNames}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding FileName}" Foreground="{StaticResource SuccessBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding FormatText}" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Log -->
        <Border Grid.Row="7" Background="{StaticResource PanelBrush}" CornerRadius="6" Height="86" Margin="0,8,0,0">
            <ScrollViewer x:Name="LogScroll" Margin="10,6" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource LogLine}"/>
            </ScrollViewer>
        </Border>

        <!-- Save -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Padding="16,9"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    Tag="{Binding CanSave, Converter={StaticResource PulseWhenTrue}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                        <Setter Property="Content" Value="▶  Save modified bank"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                <Setter Property="Content" Value="Encoding &amp; rebuilding…"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <ProgressBar Style="{StaticResource SlimProgress}" Width="220" Margin="14,0,0,0"
                         VerticalAlignment="Center" IsIndeterminate="{Binding IsSaving}"
                         Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
