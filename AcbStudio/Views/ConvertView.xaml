<UserControl x:Class="AcbStudio.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AcbStudio"
             xmlns:vm="clr-namespace:AcbStudio.ViewModels">

    <Grid Margin="24,8,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource SectionTitle}" FontSize="16" Text="Convert"/>
            <TextBlock Style="{StaticResource HintText}" Margin="12,5,0,0"
                       Text="(standalone WAV ↔ HCA, batch — no ACB/AWB needed; drag &amp; drop works)"/>
        </StackPanel>

        <!-- Output + options -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder:"/>
            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,3"
                     Text="{Binding OutDir, UpdateSourceTrigger=PropertyChanged}"
                     Tag="converted files land here with the opposite extension"/>
            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,3,0,3"
                    Content="Browse" Command="{Binding BrowseOutCommand}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,4">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Direction:"/>
            <ComboBox Style="{StaticResource DarkCombo}" Width="240" Margin="8,0,24,0"
                      ItemsSource="{x:Static vm:ConvertViewModel.DirectionChoices}"
                      SelectedIndex="{Binding DirectionIndex}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Quality (WAV→HCA):"/>
            <ComboBox Style="{StaticResource DarkCombo}" Width="300" Margin="8,0,0,0"
                      ItemsSource="{x:Static vm:ConvertViewModel.QualityChoices}"
                      SelectedIndex="{Binding QualityIndex}"/>
        </StackPanel>

        <!-- File list -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="6" Margin="0,6,0,0"
                AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
            <ListBox Style="{StaticResource DarkListBox}" SelectionMode="Extended"
                     ItemsSource="{Binding Files}"
                     ItemContainerStyle="{StaticResource TrackListItem}"
                     MouseDoubleClick="FileDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- List buttons -->
        <Grid Grid.Row="4" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Content="+ Add files…" Command="{Binding AddFilesCommand}"/>
                <Button Style="{StaticResource FlatButton}" Content="– Remove selected" Margin="6,0,0,0" Command="{Binding RemoveSelectedCommand}"/>
                <Button Style="{StaticResource FlatButton}" Content="⌫ Clear" Margin="6,0,0,0" Command="{Binding ClearCommand}"/>
                <Button Style="{StaticResource FlatButton}" Foreground="{StaticResource TextBrush}"
                        Content="♪ Preview" Margin="18,0,0,0" Command="{Binding PreviewCommand}"/>
                <Button Style="{StaticResource FlatButton}" Content="■ Stop preview" Margin="6,0,0,0"
                        Command="{Binding StopPreviewCommand}" IsEnabled="{Binding IsPreviewPlaying}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding FileCountText}"/>
        </Grid>

        <!-- Progress -->
        <Grid Grid.Row="5" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Style="{StaticResource SlimProgress}" VerticalAlignment="Center"
                         Maximum="{Binding ProgressMax}" local:Smooth.Target="{Binding Progress}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Margin="10,0,0,0"
                       VerticalAlignment="Center" Text="{Binding ProgressText}"/>
        </Grid>

        <!-- Log -->
        <Border Grid.Row="6" Background="{StaticResource PanelBrush}" CornerRadius="6" Height="96">
            <ScrollViewer x:Name="LogScroll" Margin="10,6" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource LogLine}"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Command="{Binding ConvertCommand}" IsEnabled="{Binding IsIdle}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                        <Setter Property="Content" Value="▶  Convert"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Content" Value="Converting…"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Style="{StaticResource FlatButton}" Content="■  Stop" Margin="8,0,0,0"
                    Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
        </StackPanel>
    </Grid>
</UserControl>
